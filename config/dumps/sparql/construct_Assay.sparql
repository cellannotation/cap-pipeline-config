PREFIX inSubset: <http://www.geneontology.org/formats/oboInOwl#inSubset>

# Assay terms are maintained in CAPO (src/ontology/components/efo_cap.owl) and
# tagged with the cap_assay subset; see cap_ontology docs/adding-assay-terms.md

CONSTRUCT {
	?s <http://n2o.neo/property/nodeLabel> "Assay" .
}
WHERE 
{
      ?s inSubset: <http://purl.obolibrary.org/obo/capo#cap_assay> .
}
